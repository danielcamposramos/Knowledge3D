        "stop": 184.62,
        "text": " para esse mandamento."
    },
    {
        "start": 184.62,
        "stop": 186.55,
        "text": " Não guarde a mesma coisa duas"
    },
    {
        "start": 186.55,
        "stop": 187.22,
        "text": " vezes."
