[
    {
        "start": 0,
        "stop": 1.34,
        "text": " Vamos falar sobre uma ideia que"
    },
    {
        "start": 1.34,
        "stop": 2.61,
        "text": " pode de verdade reprogramar o"
    },
    {
        "start": 2.61,
        "stop": 3.72,
        "text": " nosso mundo digital."
    },
    {
        "start": 3.72,
        "stop": 4.9,
        "text": " É uma solução que ataca um"
    },
    {
        "start": 4.9,
        "stop": 6.18,
        "text": " problema fundamental no jeito"
    },
    {
        "start": 6.18,
        "stop": 7.62,
        "text": " como a inteligência artificial"
    },
    {
        "start": 7.62,
        "stop": 8.94,
        "text": " e a própria web lidam com o"
    },
    {
        "start": 8.94,
        "stop": 9.9,
        "text": " conhecimento."
    },
    {
        "start": 9.9,
        "stop": 11.22,
        "text": " O nosso mundo digital tem um"
    },
    {
        "start": 11.22,
        "stop": 12.76,
        "text": " problema sério, um que a gente"
    },
    {
        "start": 12.76,
        "stop": 14.46,
        "text": " quase nunca para para pensar."
    },
    {
        "start": 14.46,
        "stop": 16.48,
        "text": " Quase tudo que existe online é,"
    },
    {
        "start": 16.48,
        "stop": 18.07,
        "text": " no fundo, uma cópia."
    },
    {
        "start": 18.07,
        "stop": 19.48,
        "text": " E outra cópia? E mais uma?"
    },
    {
        "start": 19.48,
        "stop": 20.6,
        "text": " Essa é a realidade."
    },
    {
        "start": 20.6,
        "stop": 21.94,
        "text": " Uma base toda construída em"
    },
    {
        "start": 21.94,
        "stop": 23.5,
        "text": " cima de uma duplicação de dados"
    },
    {
        "start": 23.5,
        "stop": 24.38,
        "text": " que é massiva,"
    },
    {
        "start": 24.38,
        "stop": 25.92,
        "text": " ineficiente e que custa muito"
    },
    {
        "start": 25.92,
        "stop": 27.54,
        "text": " tempo, dinheiro e energia."
    },
    {
        "start": 27.66,
        "stop": 29.41,
        "text": " Pois é, e aqui a gente não está"
    },
    {
        "start": 29.41,
        "stop": 30.95,
        "text": " falando de um bug pequeno ou um"
    },
    {
        "start": 30.95,
        "stop": 32.47,
        "text": " probleminha técnico."
    },
    {
        "start": 32.47,
        "stop": 34.1,
        "text": " Isso é uma verdadeira crise"
    },
    {
        "start": 34.1,
        "stop": 35.06,
        "text": " sistêmica."
    },
    {
        "start": 35.06,
        "stop": 36.97,
        "text": " Estamos gastando uma quantidade"
    },
    {
        "start": 36.97,
        "stop": 38.11,
        "text": " absurda de recursos"
    },
    {
        "start": 38.11,
        "stop": 40.03,
        "text": " só para armazenar e manter sinc"
    },
    {
        "start": 40.03,
        "stop": 42.24,
        "text": "ronizadas as mesmíssimas coisas,"
    },
    {
        "start": 42.24,
        "stop": 43.5,
        "text": " de novo e de novo."
    },
    {
        "start": 43.5,
        "stop": 45.1,
        "text": " Para entender isso na prática,"
    },
    {
        "start": 45.1,
        "stop": 46.38,
        "text": " olha só esse exemplo."
    },
    {
        "start": 46.38,
        "stop": 48.1,
        "text": " O símbolo da derivada parcial."
    },
    {
        "start": 48.1,
        "stop": 49.24,
        "text": " Parece simples, né?"
    },
    {
        "start": 49.24,
        "stop": 50.83,
        "text": " Mas para ele existir no mundo"
    },
    {
        "start": 50.83,
        "stop": 52.62,
        "text": " digital, a coisa complica."
    },
    {
        "start": 52.62,
        "stop": 54.17,
        "text": " A forma dele está guardada em"
    },
    {
        "start": 54.17,
        "stop": 55.36,
        "text": " um artigo de fonte."
    },
    {
        "start": 55.36,
        "stop": 57.13,
        "text": " O significado matemático dele,"
    },
    {
        "start": 57.13,
        "stop": 58.77,
        "text": " para o Maya entender, vira um"
    },
    {
        "start": 58.77,
        "stop": 60.08,
        "text": " monte de números."
    },
    {
        "start": 60.08,
        "stop": 61.32,
        "text": " Um tal de embedding."
    },
    {
        "start": 61.32,
        "stop": 62.8,
        "text": " E a descrição dele, para um le"
    },
    {
        "start": 62.8,
        "stop": 64.5,
        "text": "itor de tela, é outra informação"
    },
    {
        "start": 64.5,
        "stop": 65.16,
        "text": " separada."
    },
    {
        "start": 65.16,
        "stop": 66.45,
        "text": " Cada um é uma cópia, um dado"
    },
    {
        "start": 66.45,
        "stop": 67.88,
        "text": " isolado que precisa ser mantido"
    },
    {
        "start": 67.88,
        "stop": 68.95,
        "text": " por conta própria."
    },
    {
        "start": 68.95,
        "stop": 70.06,
        "text": " É uma loucura."
    },
    {
        "start": 70.06,
        "stop": 71.56,
        "text": " E o tamanho do estrago?"
    },
    {
        "start": 71.56,
        "stop": 73.04,
        "text": " Em alguns sistemas, essa crise"
    },
    {
        "start": 73.04,
        "stop": 74.29,
        "text": " de duplicação chega a ser"
    },
    {
        "start": 74.29,
        "stop": 77.36,
        "text": " responsável por mais de 70% de"
    },
    {
        "start": 77.36,
        "stop": 78.64,
        "text": " todo o desperdício de dados."
    },
    {
        "start": 79.08,
        "stop": 81.26,
        "text": " Pensa nisso. 70%."
    },
    {
        "start": 81.26,
        "stop": 82.66,
        "text": " É uma ineficiência gigantesca,"
    },
    {
        "start": 82.66,
        "stop": 83.7,
        "text": " que de alguma forma a gente"
    },
    {
        "start": 83.7,
        "stop": 84.89,
        "text": " passou a tratar como se fosse"
    },
    {
        "start": 84.89,
        "stop": 85.46,
        "text": " normal."
    },
    {
        "start": 85.46,
        "stop": 88.05,
        "text": " Tá, mas... então como a gente"
    },
    {
        "start": 88.05,
        "stop": 88.76,
        "text": " sai disso?"
    },
    {
        "start": 88.76,
        "stop": 90.68,
        "text": " A proposta é uma virada de ch"
    },
    {
        "start": 90.68,
        "stop": 91.24,
        "text": "ave."
    },
    {
        "start": 91.24,
        "stop": 92.86,
        "text": " Em vez de ficar copiando tudo,"
    },
    {
        "start": 92.86,
        "stop": 94.48,
        "text": " e se a gente pudesse só apontar"
    },
    {
        "start": 94.48,
        "stop": 95.64,
        "text": " para o original?"
    },
    {
        "start": 95.64,
        "stop": 97.32,
        "text": " Pensa num atalho de computador,"
    },
    {
        "start": 97.32,
        "stop": 97.76,
        "text": " sabe?"
    },
    {
        "start": 97.76,
        "stop": 99.14,
        "text": " O famoso SIM-link."
    },
    {
        "start": 99.14,
        "stop": 100.93,
        "text": " A ideia é essa, só que aplicada"
    },
    {
        "start": 100.93,
        "stop": 102.68,
        "text": " a todo tipo de conhecimento."
    },
    {
        "start": 102.68,
        "stop": 104.46,
        "text": " E o nome dessa abordagem é"
    },
    {
        "start": 104.46,
        "stop": 106.71,
        "text": " Representação de Conhecimento"
    },
    {
        "start": 106.71,
        "stop": 108.77,
        "text": " por Memória Procedural, ou PMKR"
    },
    {
        "start": 108.77,
        "stop": 109.08,
        "text": "."
    },
    {
        "start": 109.08,
        "stop": 110.69,
        "text": " A ideia central é de uma sim"
    },
    {
        "start": 110.69,
        "stop": 111.98,
        "text": "plicidade genial."
    },
    {
        "start": 111.98,
        "stop": 113.83,
        "text": " A memória procedural não trata"
    },
    {
        "start": 113.83,
        "stop": 115.34,
        "text": " o conhecimento como um dado"
    },
    {
        "start": 115.34,
        "stop": 116.76,
        "text": " estático, parado."
    },
    {
        "start": 116.76,
        "stop": 118.68,
        "text": " Ela o trata como um programa,"
    },
    {
        "start": 118.68,
        "stop": 119.76,
        "text": " uma receita."
    },
    {
        "start": 119.76,
        "stop": 121.31,
        "text": " O melhor exemplo é um arquivo"
    },
    {
        "start": 121.31,
        "stop": 121.9,
        "text": " de fonte."
    },
    {
        "start": 121.9,
        "stop": 123.24,
        "text": " Ele não guarda a imagem de cada"
    },
    {
        "start": 123.24,
        "stop": 124.86,
        "text": " letra em cada tamanho possível."
    },
    {
        "start": 124.86,
        "stop": 126.47,
        "text": " Ele guarda as instruções de"
    },
    {
        "start": 126.47,
        "stop": 128.22,
        "text": " como desenhar aquela letra."
    },
    {
        "start": 128.22,
        "stop": 130.13,
        "text": " A PMKR pega essa lógica e apl"
    },
    {
        "start": 130.13,
        "stop": 131.58,
        "text": "ica a todo o resto."
    },
    {
        "start": 131.58,
        "stop": 133.34,
        "text": " E aqui o contraste fica bem"
    },
    {
        "start": 133.34,
        "stop": 134,
        "text": " claro."
    },
    {
        "start": 134,
        "stop": 135.78,
        "text": " De um lado, o jeito antigo."
    },
    {
        "start": 135.78,
        "stop": 137.44,
        "text": " O caos do copiar e colar, que é"
    },
    {
        "start": 137.44,
        "stop": 139.22,
        "text": " caro, frágil, e um prato cheio"
    },
    {
        "start": 139.22,
        "stop": 140.96,
        "text": " para dar inconsistência."
    },
    {
        "start": 140.96,
        "stop": 143.34,
        "text": " Do outro, o jeito PMKR."
    },
    {
        "start": 143.34,
        "stop": 144.97,
        "text": " Referenciar e executar."
    },
    {
        "start": 144.97,
        "stop": 146.94,
        "text": " Você guarda a receita uma única"
    },
    {
        "start": 146.94,
        "stop": 147.41,
        "text": " vez."
    },
    {
        "start": 147.41,
        "stop": 148.54,
        "text": " Precisou dela?"
    },
    {
        "start": 148.54,
        "stop": 149.36,
        "text": " Só aponta."
    },
    {
        "start": 149.36,
        "stop": 150.8,
        "text": " Atualizou a receita?"
    },
    {
        "start": 150.8,
        "stop": 151.41,
        "text": " Pronto!"
    },
    {
        "start": 151.41,
        "stop": 153.19,
        "text": " Está atualizado em todo lugar."
    },
    {
        "start": 153.19,
        "stop": 154.19,
        "text": " Simples assim."
    },
    {
        "start": 154.19,
        "stop": 155.84,
        "text": " É o poder do SIM-link, do atal"
    },
    {
        "start": 155.84,
        "stop": 157.36,
        "text": "ho, levado ao mundo do conhe"
    },
    {
        "start": 157.36,
        "stop": 158.1,
        "text": "cimento."
    },
    {
        "start": 158.22,
        "stop": 160.16,
        "text": " Certo, a ideia é poderosa."
    },
    {
        "start": 160.16,
        "stop": 161.71,
        "text": " Mas como isso funciona na pr"
    },
    {
        "start": 161.71,
        "stop": 162.38,
        "text": "ática?"
    },
    {
        "start": 162.38,
        "stop": 163.87,
        "text": " Como se constrói um sistema"
    },
    {
        "start": 163.87,
        "stop": 164.42,
        "text": " assim?"
    },
    {
        "start": 164.42,
        "stop": 165.68,
        "text": " Vamos mergulhar um pouco na"
    },
    {
        "start": 165.68,
        "stop": 166.5,
        "text": " arquitetura."
    },
    {
        "start": 166.5,
        "stop": 168.2,
        "text": " Nesse caminho que leva da forma"
    },
    {
        "start": 168.2,
        "stop": 170.1,
        "text": " mais bruta até o significado."
    },
    {
        "start": 170.58,
        "stop": 172.13,
        "text": " E tudo se baseia em um princíp"
    },
    {
        "start": 172.13,
        "stop": 172.44,
        "text": "io."
    },
    {
        "start": 172.44,
        "stop": 173.3,
        "text": " Quase um mantra."
    },
    {
        "start": 173.3,
        "stop": 175.74,
        "text": " Não duplique o que já existe."
    },
    {
        "start": 175.74,
        "stop": 177.42,
        "text": " Use referências."
    },
    {
        "start": 177.42,
        "stop": 179.24,
        "text": " Essa é a regra de ouro que com"
    },
    {
        "start": 179.24,
        "stop": 181.12,
        "text": "anda toda a arquitetura."
    },
    {
        "start": 181.12,
        "stop": 183.03,
        "text": " Cada decisão de projeto volta"
    },
    {
