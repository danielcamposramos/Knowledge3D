        "stop": 243.18,
        "text": " sentido."
    },
    {
        "start": 243.18,
        "stop": 244.08,
        "text": " Mas e daí?"
    },
    {
        "start": 244.08,
        "stop": 245.63,
        "text": " O que a gente ganha com isso no"
    },
    {
        "start": 245.63,
        "stop": 246.46,
        "text": " mundo real?"
    },
    {
        "start": 246.46,
        "stop": 247.76,
        "text": " Vamos ver o impacto de"
    },
    {
