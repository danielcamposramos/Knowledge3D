        "stop": 192.68,
        "text": "adas, como se fossem blocos de"
    },
    {
        "start": 192.68,
        "stop": 193.24,
        "text": " montar."
    },
    {
        "start": 193.24,
        "stop": 195.24,
        "text": " A base de tudo é a forma."
