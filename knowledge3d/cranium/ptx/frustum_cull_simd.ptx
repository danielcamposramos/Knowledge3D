// knowledge3d/cranium/ptx/frustum_cull_simd.ptx
// Kimi's SIMD frustum culling with view-space depth check
// Performance: ~20 cycles per warp, >80% reduction target

.version 7.8
.target sm_80
.address_size 64

// Constant memory: view-projection matrix (4x4 f32 = 64 bytes)
.const .align 16 .f32 view_proj[16];

// View matrix for depth check (4x4 f32 = 64 bytes)
.const .align 16 .f32 view_matrix[16];

.entry warp_frustum_cull_simd(
    .param .u64 positions_ptr,
    .param .u64 candidates_ptr,
    .param .u32 node_count,
    .param .u64 visible_flags_ptr
)
{
    .reg .pred p_inactive, p_cull;
    .reg .u32 lane, block, block_dim;
    .reg .u32 global_idx, count, cand_idx;
    .reg .u64 pos_base, pos_ptr;
    .reg .u64 cand_base, cand_ptr;
    .reg .u64 flags_base, flag_ptr;
    .reg .u64 offset;
    .reg .f32 x, y, z, w;
    .reg .f32 px, py, pz, pw;
    .reg .f32 vz;  // View-space Z for depth test
    .reg .f32 row0x, row0y, row0z, row0w;
    .reg .f32 row1x, row1y, row1z, row1w;
    .reg .f32 row2x, row2y, row2z, row2w;
    .reg .f32 row3x, row3y, row3z, row3w;
    .reg .f32 vrow2x, vrow2y, vrow2z, vrow2w;  // View matrix row 2 for depth
    .reg .f32 neg_pw, ndc_x, ndc_y, ndc_z;
    .reg .f32 margin_xy, neg_margin_xy, margin_z, neg_margin_z;

    mov.u32 lane, %tid.x;
    mov.u32 block, %ctaid.x;
    mov.u32 block_dim, %ntid.x;

    mul.lo.u32 global_idx, block, block_dim;
    add.u32 global_idx, global_idx, lane;

    ld.param.u32 count, [node_count];
    setp.ge.u32 p_inactive, global_idx, count;
    @p_inactive bra EXIT;

    // Load candidate index
    ld.param.u64 cand_base, [candidates_ptr];
    mul.wide.u32 offset, global_idx, 4;
    add.u64 cand_ptr, cand_base, offset;
    ld.global.u32 cand_idx, [cand_ptr];

    // Load position
    ld.param.u64 pos_base, [positions_ptr];
    mul.wide.u32 pos_ptr, cand_idx, 12;
    add.u64 pos_ptr, pos_base, pos_ptr;

    ld.global.f32 x, [pos_ptr + 0];
    ld.global.f32 y, [pos_ptr + 4];
    ld.global.f32 z, [pos_ptr + 8];
    mov.f32 w, 1.0;

    // ========================================
    // STEP 1: View-space depth test (behind camera check)
    // ========================================
    // Load view matrix row 2 (forward direction in view space)
    ld.const.v4.f32 {vrow2x, vrow2y, vrow2z, vrow2w}, [view_matrix + 32];

    // Compute view-space Z: vz = row2·[x,y,z,1]
    mul.f32 vz, vrow2x, x;
    fma.rn.f32 vz, vrow2y, y, vz;
    fma.rn.f32 vz, vrow2z, z, vz;
    fma.rn.f32 vz, vrow2w, w, vz;

    // In OpenGL view space, camera looks down -Z, so visible points have vz < 0
    // Cull if vz >= 0 (behind or at camera)
    setp.ge.f32 p_cull, vz, 0.0;
    @p_cull bra STORE_CULLED;

    // ========================================
    // STEP 2: Clip-space projection
    // ========================================
    // Load view-projection matrix
    ld.const.v4.f32 {row0x, row0y, row0z, row0w}, [view_proj + 0];
    ld.const.v4.f32 {row1x, row1y, row1z, row1w}, [view_proj + 16];
    ld.const.v4.f32 {row2x, row2y, row2z, row2w}, [view_proj + 32];
    ld.const.v4.f32 {row3x, row3y, row3z, row3w}, [view_proj + 48];

    // Transform to clip space: p_clip = view_proj * [x,y,z,1]
    mul.f32 px, row0x, x;
    fma.rn.f32 px, row0y, y, px;
    fma.rn.f32 px, row0z, z, px;
    fma.rn.f32 px, row0w, w, px;

    mul.f32 py, row1x, x;
    fma.rn.f32 py, row1y, y, py;
    fma.rn.f32 py, row1z, z, py;
    fma.rn.f32 py, row1w, w, py;

    mul.f32 pz, row2x, x;
    fma.rn.f32 pz, row2y, y, pz;
    fma.rn.f32 pz, row2z, z, pz;
    fma.rn.f32 pz, row2w, w, pz;

    mul.f32 pw, row3x, x;
    fma.rn.f32 pw, row3y, y, pw;
    fma.rn.f32 pw, row3z, z, pw;
    fma.rn.f32 pw, row3w, w, pw;

    // ========================================
    // STEP 3: Perspective divide to NDC
    // ========================================
    // Cull if pw <= 0 (degenerate projection)
    setp.le.f32 p_cull, pw, 0.0;
    @p_cull bra STORE_CULLED;

    // Divide by w to get NDC coordinates
    div.approx.f32 ndc_x, px, pw;
    div.approx.f32 ndc_y, py, pw;
    div.approx.f32 ndc_z, pz, pw;

    // ========================================
    // STEP 4: Frustum bounds test with margin
    // ========================================
    // NDC range is [-1, 1] for visible region
    // Add small margin (0.05) to account for node extent
    mov.f32 margin_xy, 0.11;
    neg.f32 neg_margin_xy, margin_xy;
    mov.f32 margin_z, 1.0;
    neg.f32 neg_margin_z, margin_z;

    // Test X bounds: -margin <= ndc_x <= margin
    setp.lt.f32 p_cull, ndc_x, neg_margin_xy;
    @p_cull bra STORE_CULLED;
    setp.gt.f32 p_cull, ndc_x, margin_xy;
    @p_cull bra STORE_CULLED;

    // Test Y bounds: -margin <= ndc_y <= margin
    setp.lt.f32 p_cull, ndc_y, neg_margin_xy;
    @p_cull bra STORE_CULLED;
    setp.gt.f32 p_cull, ndc_y, margin_xy;
    @p_cull bra STORE_CULLED;

    // Test Z bounds (depth): -margin <= ndc_z <= margin
    setp.lt.f32 p_cull, ndc_z, neg_margin_z;
    @p_cull bra STORE_CULLED;
    setp.gt.f32 p_cull, ndc_z, margin_z;
    @p_cull bra STORE_CULLED;

    // ========================================
    // VISIBLE: Store flag = 1
    // ========================================
    ld.param.u64 flags_base, [visible_flags_ptr];
    mul.wide.u32 offset, global_idx, 1;
    add.u64 flag_ptr, flags_base, offset;
    st.global.u8 [flag_ptr], 1;
    bra EXIT;

STORE_CULLED:
    // CULLED: Store flag = 0
    ld.param.u64 flags_base, [visible_flags_ptr];
    mul.wide.u32 offset, global_idx, 1;
    add.u64 flag_ptr, flags_base, offset;
    st.global.u8 [flag_ptr], 0;

EXIT:
    ret;
}
