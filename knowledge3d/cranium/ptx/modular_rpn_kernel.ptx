    mul.f32 %f2, %f286, %f293; mad.f32 %f2, %f296, %f292, %f2; mad.f32 %f2, %f291, %f297, %f2;
    mov.f32 %f3, 0f00000000;
    bra push_value;

// -------------------------------------------------------------------
// Conditional if-else (cond, true, false) -> selects
// -------------------------------------------------------------------
op_ifelse:
    setp.eq.u32 %p_u45, %r11, 0; @%p_u45 bra error_underflow;
    sub.u32 %r490, %r11, 1; add.u32 %r491, %r10, %r490; and.b32 %r492, %r491, %r101; mul.wide.u32 %rd490, %r492, %r102; add.u64 %rd491, %rd12, %rd490; ld.global.f32 %f300, [%rd491]; ld.global.f32 %f301, [%rd491+4]; ld.global.f32 %f302, [%rd491+8]; mov.u32 %r11, %r490; setp.eq.u32 %p_reset47, %r11, 0; @%p_reset47 mov.u32 %r10, 0;
    setp.eq.u32 %p_u46, %r11, 0; @%p_u46 bra error_underflow;
    sub.u32 %r493, %r11, 1; add.u32 %r494, %r10, %r493; and.b32 %r495, %r494, %r101; mul.wide.u32 %rd492, %r495, %r102; add.u64 %rd493, %rd12, %rd492; ld.global.f32 %f303, [%rd493]; ld.global.f32 %f304, [%rd493+4]; ld.global.f32 %f305, [%rd493+8]; mov.u32 %r11, %r493; setp.eq.u32 %p_reset48, %r11, 0; @%p_reset48 mov.u32 %r10, 0;
    setp.eq.u32 %p_u47, %r11, 0; @%p_u47 bra error_underflow;
    sub.u32 %r496, %r11, 1; add.u32 %r497, %r10, %r496; and.b32 %r498, %r497, %r101; mul.wide.u32 %rd494, %r498, %r102; add.u64 %rd495, %rd12, %rd494; ld.global.f32 %f306, [%rd495]; mov.u32 %r11, %r496; setp.eq.u32 %p_reset49, %r11, 0; @%p_reset49 mov.u32 %r10, 0;
    setp.ne.f32 %p_cond, %f306, 0f00000000;
    selp.f32 %f0, %f303, %f300, %p_cond; selp.f32 %f1, %f304, %f301, %p_cond; selp.f32 %f2, %f305, %f302, %p_cond; mov.f32 %f3, 0f00000000;
    bra push_value;

// -------------------------------------------------------------------
// Push helper (value in %f0-%f3)
// -------------------------------------------------------------------
push_value:
    mov.u32 %r500, %r11;
    add.u32 %r501, %r10, %r500;
    and.b32 %r502, %r501, %r101;
    mul.wide.u32 %rd500, %r502, %r102;
    add.u64 %rd501, %rd12, %rd500;
    st.global.f32 [%rd501], %f0;
    st.global.f32 [%rd501+4], %f1;
    st.global.f32 [%rd501+8], %f2;
    st.global.f32 [%rd501+12], %f3;
    setp.lt.u32 %p_space, %r500, %r100;
    @%p_space add.u32 %r11, %r500, 1;
    @!%p_space {
        add.u32 %r10, %r10, 1;
        and.b32 %r10, %r10, %r101;
        mov.u32 %r11, %r500;
    }
    add.u32 %r120, %r120, 1;
    bra main_loop;

// -------------------------------------------------------------------
// Underflow handler
// -------------------------------------------------------------------
error_underflow:
    mov.u32 %r130, 9002;
    bra loop_end;

loop_end:
    st.global.u32 [%rd11],   %r10;
    st.global.u32 [%rd11+4], %r11;
    st.global.u32 [%rd11+8], %r130;
    ret;

finish:
    st.global.u32 [%rd11],   %r10;
    st.global.u32 [%rd11+4], %r11;
    st.global.u32 [%rd11+8], %r130;
    ret;
}
