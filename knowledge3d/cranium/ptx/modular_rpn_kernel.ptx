    sub.u32 %r493, %r11, 1; add.u32 %r494, %r10, %r493; and.b32 %r495, %r494, %r101; mul.wide.u32 %rd492, %r495, %r102; add.u64 %rd493, %rd12, %rd492; ld.global.f32 %f303, [%rd493]; ld.global.f32 %f304, [%rd493+4]; ld.global.f32 %f305, [%rd493+8]; mov.u32 %r11, %r493; setp.eq.u32 %p608, %r11, 0; @%p608 mov.u32 %r10, 0;
    setp.eq.u32 %p1177, %r11, 0; @%p1177 bra error_underflow;
    sub.u32 %r496, %r11, 1; add.u32 %r497, %r10, %r496; and.b32 %r498, %r497, %r101; mul.wide.u32 %rd494, %r498, %r102; add.u64 %rd495, %rd12, %rd494; ld.global.f32 %f306, [%rd495]; mov.u32 %r11, %r496; setp.eq.u32 %p609, %r11, 0; @%p609 mov.u32 %r10, 0;
    setp.ne.f32 %p15, %f306, 0f00000000;
    selp.f32 %f0, %f303, %f300, %p15; selp.f32 %f1, %f304, %f301, %p15; selp.f32 %f2, %f305, %f302, %p15; mov.f32 %f3, 0f00000000;
    bra push_value;

// -------------------------------------------------------------------
// Push helper (value in %f0-%f3)
// -------------------------------------------------------------------
push_value:
    mov.u32 %r500, %r11;
    add.u32 %r501, %r10, %r500;
    and.b32 %r502, %r501, %r101;
    mul.wide.u32 %rd500, %r502, %r102;
    add.u64 %rd501, %rd12, %rd500;
    st.global.f32 [%rd501], %f0;
    st.global.f32 [%rd501+4], %f1;
    st.global.f32 [%rd501+8], %f2;
    st.global.f32 [%rd501+12], %f3;
    setp.lt.u32 %p76, %r500, %r100;
    @%p76 add.u32 %r11, %r500, 1;
    @!%p76 bra overflow_handle;
    add.u32 %r120, %r120, 1;
    bra main_loop;

overflow_handle:
    add.u32 %r10, %r10, 1;
    and.b32 %r10, %r10, %r101;
    mov.u32 %r11, %r500;
    add.u32 %r120, %r120, 1;
    bra main_loop;

// -------------------------------------------------------------------
// Underflow handler
// -------------------------------------------------------------------
error_underflow:
    mov.u32 %r130, 9002;
    bra loop_end;

loop_end:
    st.global.u32 [%rd11],   %r10;
    st.global.u32 [%rd11+4], %r11;
    st.global.u32 [%rd11+8], %r130;
    ret;

finish:
    st.global.u32 [%rd11],   %r10;
    st.global.u32 [%rd11+4], %r11;
    st.global.u32 [%rd11+8], %r130;
    ret;
}

