.version 8.0
.target sm_86
.address_size 64

// Modular RPN Geometric Kernel
// Supports 15 instances. Each instance owns a circular stack of 64 float4 entries.
// Opcodes are uint16; literals provided via scalar/vector streams.

.visible .entry modular_rpn_geometric_kernel(
    .param .u32 param_instance_id,
    .param .u64 param_op_codes,
    .param .u64 param_scalars,
    .param .u64 param_vectors,
    .param .u64 param_state,
    .param .u32 param_token_count
)
{
    .reg .pred %p<2000>;
    .reg .b16 %rh<8>;
    .reg .b32 %r<600>;
    .reg .b64 %rd<600>;
    .reg .f32 %f<400>;

    // Load params
    ld.param.u32 %r0, [param_instance_id];
    ld.param.u64 %rd0, [param_op_codes];
    ld.param.u64 %rd1, [param_scalars];
    ld.param.u64 %rd2, [param_vectors];
    ld.param.u64 %rd3, [param_state];
    ld.param.u32 %r1, [param_token_count];

    // Constants
    mov.u32 %r100, 64;        // STACK_MAX
    mov.u32 %r101, 63;        // STACK_MASK
    mov.u32 %r102, 16;        // stack element stride (float4)
    mov.u32 %r103, 1040;      // instance stride bytes
    mov.u32 %r104, 16;        // stack offset inside struct

    // Clamp instance id to 0-14
    setp.ge.u32 %p0, %r0, 15;
    @%p0 mov.u32 %r0, 14;

    mul.wide.u32 %rd10, %r0, %r103;
    add.u64 %rd11, %rd3, %rd10;      // instance base
    cvt.u64.u32 %rd13, %r104;
    add.u64 %rd12, %rd11, %rd13;     // stack base

    ld.global.u32 %r10, [%rd11];     // head
    ld.global.u32 %r11, [%rd11+4];   // size
    ld.global.u32 %r12, [%rd11+8];   // error code
    mov.u32 %r120, 0;                // token index

    mov.u32 %r130, 0;                // local error accumulator

    setp.eq.u32 %p16, %r1, 0;
    @%p16 bra finish;

main_loop:
    setp.ge.u32 %p17, %r120, %r1;
    @%p17 bra loop_end;

    // Load opcode
    mul.wide.u32 %rd20, %r120, 2;
    add.u64 %rd21, %rd0, %rd20;
    ld.global.u16 %rh0, [%rd21];
    cvt.u32.u16 %r20, %rh0;

    // Addresses for literal pools
    mul.wide.u32 %rd22, %r120, 4;
    add.u64 %rd23, %rd1, %rd22;      // scalar pointer
    mul.wide.u32 %rd24, %r120, 12;
    add.u64 %rd25, %rd2, %rd24;      // vector pointer

    //------------------------------------------------------------------
    // Literal (scalar)
    //------------------------------------------------------------------
    setp.eq.u32 %p19, %r20, 0;
    @%p19 bra op_literal_scalar;
    setp.eq.u32 %p20, %r20, 1;
    @%p20 bra op_literal_vector;

    //------------------------------------------------------------------
    // Arithmetic
    //------------------------------------------------------------------
    setp.eq.u32 %p1, %r20, 10;
    @%p1 bra op_add;
    setp.eq.u32 %p12, %r20, 11;
    @%p12 bra op_sub;
    setp.eq.u32 %p13, %r20, 12;
    @%p13 bra op_mul;
    setp.eq.u32 %p14, %r20, 13;
    @%p14 bra op_div;
    setp.eq.u32 %p15, %r20, 14;
    @%p15 bra op_pow;
    setp.eq.u32 %p16, %r20, 15;
    @%p16 bra op_neg;

    //------------------------------------------------------------------
    // Advanced math
    //------------------------------------------------------------------
    setp.eq.u32 %p25, %r20, 20;
    @%p25 bra op_sqrt;
    setp.eq.u32 %p22, %r20, 21;
    @%p22 bra op_exp;
    setp.eq.u32 %p23, %r20, 22;
    @%p23 bra op_log;
    setp.eq.u32 %p24, %r20, 24;
    @%p24 bra op_sin;
    setp.eq.u32 %p21, %r20, 25;
    @%p21 bra op_cos;
    setp.eq.u32 %p26, %r20, 26;
    @%p26 bra op_tan;

    //------------------------------------------------------------------
    // Comparisons / selection
    //------------------------------------------------------------------
    setp.eq.u32 %p11, %r20, 40;
    @%p11 bra op_gt;
    setp.eq.u32 %p12, %r20, 42;
    @%p12 bra op_lt;
    setp.eq.u32 %p10, %r20, 44;
    @%p10 bra op_eq;
    setp.eq.u32 %p13, %r20, 46;
    @%p13 bra op_max;
    setp.eq.u32 %p14, %r20, 47;
    @%p14 bra op_min;

    //------------------------------------------------------------------
    // Stack manipulation
    //------------------------------------------------------------------
    setp.eq.u32 %p79, %r20, 50;
    @%p79 bra op_dup;
    setp.eq.u32 %p82, %r20, 51;
    @%p82 bra op_swap;
    setp.eq.u32 %p78, %r20, 52;
    @%p78 bra op_drop;
    setp.eq.u32 %p80, %r20, 53;
    @%p80 bra op_over;
    setp.eq.u32 %p81, %r20, 54;
    @%p81 bra op_rot;
    setp.eq.u32 %p77, %r20, 55;
    @%p77 bra op_clear;

    //------------------------------------------------------------------
    // Vector operations
    //------------------------------------------------------------------
    setp.eq.u32 %p132, %r20, 60;
    @%p132 bra op_dot;
    setp.eq.u32 %p131, %r20, 61;
    @%p131 bra op_cross;
    setp.eq.u32 %p133, %r20, 62;
    @%p133 bra op_mag;
    setp.eq.u32 %p134, %r20, 63;
    @%p134 bra op_norm;
    setp.eq.u32 %p135, %r20, 70;
    @%p135 bra op_rotate;
    setp.eq.u32 %p136, %r20, 71;
    @%p136 bra op_scale;
    setp.eq.u32 %p137, %r20, 72;
    @%p137 bra op_translate;

    //------------------------------------------------------------------
    // Conditional
    //------------------------------------------------------------------
    setp.eq.u32 %p18, %r20, 80;
    @%p18 bra op_ifelse;

    //------------------------------------------------------------------
    // Unknown opcode -> error
    mov.u32 %r130, 9001;
    bra loop_end;

// -------------------------------------------------------------------
// Literal push (scalar)
// -------------------------------------------------------------------
op_literal_scalar:
    ld.global.f32 %f0, [%rd23];
    mov.f32 %f1, 0f00000000;
    mov.f32 %f2, 0f00000000;
    mov.f32 %f3, 0f00000000;
    bra push_value;

op_literal_vector:
    ld.global.f32 %f0, [%rd25];
    ld.global.f32 %f1, [%rd25+4];
    ld.global.f32 %f2, [%rd25+8];
    mov.f32 %f3, 0f00000000;
    bra push_value;

// -------------------------------------------------------------------
// Arithmetic operations
// -------------------------------------------------------------------
op_add:
    // pop b
    setp.eq.u32 %p83, %r11, 0;
    @%p83 bra error_underflow;
    sub.u32 %r200, %r11, 1;
    add.u32 %r201, %r10, %r200;
    and.b32 %r202, %r201, %r101;
    mul.wide.u32 %rd200, %r202, %r102;
    add.u64 %rd201, %rd12, %rd200;
    ld.global.f32 %f10, [%rd201];
    ld.global.f32 %f11, [%rd201+4];
    ld.global.f32 %f12, [%rd201+8];
    ld.global.f32 %f13, [%rd201+12];
    mov.u32 %r11, %r200;
    setp.eq.u32 %p27, %r11, 0;
    @%p27 mov.u32 %r10, 0;
    // pop a
    setp.eq.u32 %p84, %r11, 0;
    @%p84 bra error_underflow;
    sub.u32 %r203, %r11, 1;
    add.u32 %r204, %r10, %r203;
    and.b32 %r205, %r204, %r101;
    mul.wide.u32 %rd202, %r205, %r102;
    add.u64 %rd203, %rd12, %rd202;
    ld.global.f32 %f14, [%rd203];
    ld.global.f32 %f15, [%rd203+4];
    ld.global.f32 %f16, [%rd203+8];
    ld.global.f32 %f17, [%rd203+12];
    mov.u32 %r11, %r203;
    setp.eq.u32 %p28, %r11, 0;
    @%p28 mov.u32 %r10, 0;
    add.f32 %f0, %f14, %f10;
    add.f32 %f1, %f15, %f11;
    add.f32 %f2, %f16, %f12;
    add.f32 %f3, %f17, %f13;
    bra push_value;

op_sub:
    // pop b
    setp.eq.u32 %p95, %r11, 0;
    @%p95 bra error_underflow;
    sub.u32 %r210, %r11, 1;
    add.u32 %r211, %r10, %r210;
    and.b32 %r212, %r211, %r101;
    mul.wide.u32 %rd210, %r212, %r102;
    add.u64 %rd211, %rd12, %rd210;
    ld.global.f32 %f20, [%rd211];
    ld.global.f32 %f21, [%rd211+4];
    ld.global.f32 %f22, [%rd211+8];
    ld.global.f32 %f23, [%rd211+12];
    mov.u32 %r11, %r210;
    setp.eq.u32 %p39, %r11, 0;
    @%p39 mov.u32 %r10, 0;
    // pop a
    setp.eq.u32 %p106, %r11, 0;
    @%p106 bra error_underflow;
    sub.u32 %r213, %r11, 1;
    add.u32 %r214, %r10, %r213;
    and.b32 %r215, %r214, %r101;
    mul.wide.u32 %rd212, %r215, %r102;
    add.u64 %rd213, %rd12, %rd212;
    ld.global.f32 %f24, [%rd213];
    ld.global.f32 %f25, [%rd213+4];
    ld.global.f32 %f26, [%rd213+8];
    ld.global.f32 %f27, [%rd213+12];
    mov.u32 %r11, %r213;
    setp.eq.u32 %p49, %r11, 0;
    @%p49 mov.u32 %r10, 0;
    sub.f32 %f0, %f24, %f20;
    sub.f32 %f1, %f25, %f21;
    sub.f32 %f2, %f26, %f22;
    sub.f32 %f3, %f27, %f23;
    bra push_value;

op_mul:
    // pop b
    setp.eq.u32 %p117, %r11, 0;
    @%p117 bra error_underflow;
    sub.u32 %r220, %r11, 1;
    add.u32 %r221, %r10, %r220;
    and.b32 %r222, %r221, %r101;
    mul.wide.u32 %rd220, %r222, %r102;
    add.u64 %rd221, %rd12, %rd220;
    ld.global.f32 %f30, [%rd221];
    ld.global.f32 %f31, [%rd221+4];
    ld.global.f32 %f32, [%rd221+8];
    ld.global.f32 %f33, [%rd221+12];
    mov.u32 %r11, %r220;
    setp.eq.u32 %p60, %r11, 0;
    @%p60 mov.u32 %r10, 0;
    // pop a
    setp.eq.u32 %p126, %r11, 0;
    @%p126 bra error_underflow;
    sub.u32 %r223, %r11, 1;
    add.u32 %r224, %r10, %r223;
    and.b32 %r225, %r224, %r101;
    mul.wide.u32 %rd222, %r225, %r102;
    add.u64 %rd223, %rd12, %rd222;
    ld.global.f32 %f34, [%rd223];
    ld.global.f32 %f35, [%rd223+4];
    ld.global.f32 %f36, [%rd223+8];
    ld.global.f32 %f37, [%rd223+12];
    mov.u32 %r11, %r223;
    setp.eq.u32 %p71, %r11, 0;
    @%p71 mov.u32 %r10, 0;
    mul.f32 %f0, %f34, %f30;
    mul.f32 %f1, %f35, %f31;
    mul.f32 %f2, %f36, %f32;
    mul.f32 %f3, %f37, %f33;
    bra push_value;

op_div:
    // pop b
    setp.eq.u32 %p127, %r11, 0;
    @%p127 bra error_underflow;
    sub.u32 %r230, %r11, 1;
    add.u32 %r231, %r10, %r230;
    and.b32 %r232, %r231, %r101;
    mul.wide.u32 %rd230, %r232, %r102;
    add.u64 %rd231, %rd12, %rd230;
    ld.global.f32 %f40, [%rd231];
    ld.global.f32 %f41, [%rd231+4];
    ld.global.f32 %f42, [%rd231+8];
    ld.global.f32 %f43, [%rd231+12];
    mov.u32 %r11, %r230;
    setp.eq.u32 %p72, %r11, 0;
    @%p72 mov.u32 %r10, 0;
    // pop a
    setp.eq.u32 %p128, %r11, 0;
    @%p128 bra error_underflow;
    sub.u32 %r233, %r11, 1;
    add.u32 %r234, %r10, %r233;
    and.b32 %r235, %r234, %r101;
    mul.wide.u32 %rd232, %r235, %r102;
    add.u64 %rd233, %rd12, %rd232;
    ld.global.f32 %f44, [%rd233];
    ld.global.f32 %f45, [%rd233+4];
    ld.global.f32 %f46, [%rd233+8];
    ld.global.f32 %f47, [%rd233+12];
    mov.u32 %r11, %r233;
    setp.eq.u32 %p73, %r11, 0;
    @%p73 mov.u32 %r10, 0;
    div.full.f32 %f0, %f44, %f40;
    div.full.f32 %f1, %f45, %f41;
    div.full.f32 %f2, %f46, %f42;
    div.full.f32 %f3, %f47, %f43;
    bra push_value;

op_pow:
    // pop exponent
    setp.eq.u32 %p129, %r11, 0;
    @%p129 bra error_underflow;
    sub.u32 %r240, %r11, 1;
    add.u32 %r241, %r10, %r240;
    and.b32 %r242, %r241, %r101;
    mul.wide.u32 %rd240, %r242, %r102;
    add.u64 %rd241, %rd12, %rd240;
    ld.global.f32 %f50, [%rd241];
    mov.u32 %r11, %r240;
    setp.eq.u32 %p74, %r11, 0;
    @%p74 mov.u32 %r10, 0;
    // pop base
    setp.eq.u32 %p130, %r11, 0;
    @%p130 bra error_underflow;
    sub.u32 %r243, %r11, 1;
    add.u32 %r244, %r10, %r243;
    and.b32 %r245, %r244, %r101;
    mul.wide.u32 %rd242, %r245, %r102;
    add.u64 %rd243, %rd12, %rd242;
    ld.global.f32 %f51, [%rd243];
    mov.u32 %r11, %r243;
    setp.eq.u32 %p75, %r11, 0;
    @%p75 mov.u32 %r10, 0;
    abs.f32 %f52, %f51;
    max.f32 %f52, %f52, 0f358637bd;
    lg2.approx.f32 %f53, %f52;
    mul.f32 %f54, %f53, %f50;
    ex2.approx.f32 %f0, %f54;
    mov.f32 %f1, 0f00000000;
    mov.f32 %f2, 0f00000000;
    mov.f32 %f3, 0f00000000;
    bra push_value;

op_neg:
    setp.eq.u32 %p840, %r11, 0;
    @%p840 bra error_underflow;
    sub.u32 %r250, %r11, 1;
    add.u32 %r251, %r10, %r250;
    and.b32 %r252, %r251, %r101;
    mul.wide.u32 %rd250, %r252, %r102;
    add.u64 %rd251, %rd12, %rd250;
    ld.global.f32 %f60, [%rd251];
    ld.global.f32 %f61, [%rd251+4];
    ld.global.f32 %f62, [%rd251+8];
    ld.global.f32 %f63, [%rd251+12];
    mov.u32 %r11, %r250;
    setp.eq.u32 %p280, %r11, 0;
    @%p280 mov.u32 %r10, 0;
    neg.f32 %f0, %f60;
    neg.f32 %f1, %f61;
    neg.f32 %f2, %f62;
    neg.f32 %f3, %f63;
    bra push_value;

op_sqrt:
    setp.eq.u32 %p841, %r11, 0;
    @%p841 bra error_underflow;
    sub.u32 %r260, %r11, 1;
    add.u32 %r261, %r10, %r260;
    and.b32 %r262, %r261, %r101;
    mul.wide.u32 %rd260, %r262, %r102;
    add.u64 %rd261, %rd12, %rd260;
    ld.global.f32 %f70, [%rd261];
    mov.u32 %r11, %r260;
    setp.eq.u32 %p281, %r11, 0;
    @%p281 mov.u32 %r10, 0;
    max.f32 %f71, %f70, 0f00000000;
    sqrt.rn.f32 %f0, %f71;
    mov.f32 %f1, 0f00000000;
    mov.f32 %f2, 0f00000000;
    mov.f32 %f3, 0f00000000;
    bra push_value;

op_exp:
    setp.eq.u32 %p842, %r11, 0;
    @%p842 bra error_underflow;
    sub.u32 %r270, %r11, 1;
    add.u32 %r271, %r10, %r270;
    and.b32 %r272, %r271, %r101;
    mul.wide.u32 %rd270, %r272, %r102;
    add.u64 %rd271, %rd12, %rd270;
    ld.global.f32 %f80, [%rd271];
    mov.u32 %r11, %r270;
    setp.eq.u32 %p282, %r11, 0;
    @%p282 mov.u32 %r10, 0;
    mul.f32 %f81, %f80, 0f3fb8aa3b; // 1/log2(e)
    ex2.approx.f32 %f0, %f81;
    mov.f32 %f1, 0f00000000;
    mov.f32 %f2, 0f00000000;
    mov.f32 %f3, 0f00000000;
    bra push_value;

op_log:
    setp.eq.u32 %p843, %r11, 0;
    @%p843 bra error_underflow;
    sub.u32 %r280, %r11, 1;
    add.u32 %r281, %r10, %r280;
    and.b32 %r282, %r281, %r101;
    mul.wide.u32 %rd280, %r282, %r102;
    add.u64 %rd281, %rd12, %rd280;
    ld.global.f32 %f90, [%rd281];
    mov.u32 %r11, %r280;
    setp.eq.u32 %p283, %r11, 0;
    @%p283 mov.u32 %r10, 0;
    max.f32 %f91, %f90, 0f358637bd;
    lg2.approx.f32 %f92, %f91;
    mul.f32 %f0, %f92, 0f3f317218; // * ln(2)
    mov.f32 %f1, 0f00000000;
    mov.f32 %f2, 0f00000000;
    mov.f32 %f3, 0f00000000;
    bra push_value;

op_sin:
    setp.eq.u32 %p844, %r11, 0;
    @%p844 bra error_underflow;
    sub.u32 %r290, %r11, 1;
    add.u32 %r291, %r10, %r290;
    and.b32 %r292, %r291, %r101;
    mul.wide.u32 %rd290, %r292, %r102;
    add.u64 %rd291, %rd12, %rd290;
    ld.global.f32 %f100, [%rd291];
    mov.u32 %r11, %r290;
    setp.eq.u32 %p284, %r11, 0;
    @%p284 mov.u32 %r10, 0;
    sin.approx.f32 %f0, %f100;
    mov.f32 %f1, 0f00000000;
    mov.f32 %f2, 0f00000000;
    mov.f32 %f3, 0f00000000;
    bra push_value;

op_cos:
    setp.eq.u32 %p845, %r11, 0;
    @%p845 bra error_underflow;
    sub.u32 %r300, %r11, 1;
    add.u32 %r301, %r10, %r300;
    and.b32 %r302, %r301, %r101;
    mul.wide.u32 %rd300, %r302, %r102;
    add.u64 %rd301, %rd12, %rd300;
    ld.global.f32 %f110, [%rd301];
    mov.u32 %r11, %r300;
    setp.eq.u32 %p285, %r11, 0;
    @%p285 mov.u32 %r10, 0;
    cos.approx.f32 %f0, %f110;
    mov.f32 %f1, 0f00000000;
    mov.f32 %f2, 0f00000000;
    mov.f32 %f3, 0f00000000;
    bra push_value;

op_tan:
    setp.eq.u32 %p846, %r11, 0;
    @%p846 bra error_underflow;
    sub.u32 %r310, %r11, 1;
    add.u32 %r311, %r10, %r310;
    and.b32 %r312, %r311, %r101;
    mul.wide.u32 %rd310, %r312, %r102;
    add.u64 %rd311, %rd12, %rd310;
    ld.global.f32 %f120, [%rd311];
    mov.u32 %r11, %r310;
    setp.eq.u32 %p286, %r11, 0;
    @%p286 mov.u32 %r10, 0;
    sin.approx.f32 %f121, %f120;
    cos.approx.f32 %f122, %f120;
    div.full.f32 %f0, %f121, %f122;
    mov.f32 %f1, 0f00000000;
    mov.f32 %f2, 0f00000000;
    mov.f32 %f3, 0f00000000;
    bra push_value;

// -------------------------------------------------------------------
// Comparisons
// -------------------------------------------------------------------
op_gt:
    // pop b
    setp.eq.u32 %p847, %r11, 0;
    @%p847 bra error_underflow;
    sub.u32 %r320, %r11, 1;
    add.u32 %r321, %r10, %r320;
    and.b32 %r322, %r321, %r101;
    mul.wide.u32 %rd320, %r322, %r102;
    add.u64 %rd321, %rd12, %rd320;
    ld.global.f32 %f130, [%rd321];
    mov.u32 %r11, %r320;
    setp.eq.u32 %p287, %r11, 0;
    @%p287 mov.u32 %r10, 0;
    // pop a
    setp.eq.u32 %p848, %r11, 0;
    @%p848 bra error_underflow;
    sub.u32 %r323, %r11, 1;
    add.u32 %r324, %r10, %r323;
    and.b32 %r325, %r324, %r101;
    mul.wide.u32 %rd322, %r325, %r102;
    add.u64 %rd323, %rd12, %rd322;
    ld.global.f32 %f131, [%rd323];
    mov.u32 %r11, %r323;
    setp.eq.u32 %p288, %r11, 0;
    @%p288 mov.u32 %r10, 0;
    setp.gt.f32 %p7, %f131, %f130;
    selp.f32 %f0, 0f3f800000, 0f00000000, %p7;
    mov.f32 %f1, 0f00000000;
    mov.f32 %f2, 0f00000000;
    mov.f32 %f3, 0f00000000;
    bra push_value;

op_lt:
    // Similar to gt but lt
