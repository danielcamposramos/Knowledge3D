.version 8.0
.target sm_80
.address_size 64

// Tiny Recursive Model (TRM) core kernel
// Performs n_recursions refinement steps on (y, z) given question embeddings.

.visible .entry gre_trm_core(
    .param .u64 question_ptr,
    .param .u64 answer_ptr,
    .param .u64 latent_ptr,
    .param .u64 weights_ptr,       // reserved
    .param .u32 batch_size,
    .param .u32 hidden_dim,
    .param .u32 n_recursions,
    .param .u32 with_gradients,    // reserved
    .param .f32 epsilon,
    .param .u64 answer_out_ptr,
    .param .u64 latent_out_ptr,
    .param .u64 halt_flags_ptr
)
{
    .reg .pred p_is_thread0, p_batch_exit, p_rec_exit, p_elem_exit, p_halt;
    .reg .u32 tid, block_idx, batch, dim, rec_count, rec_limit;
    .reg .u32 elem_idx;
    .reg .u64 q_base, curr_y_base, curr_z_base, next_y_base, next_z_base;
    .reg .u64 answer_out_base, latent_out_base, flag_ptr;
    .reg .u64 offset, ptr_q, ptr_y, ptr_z, ptr_out;
    .reg .f32 f_q, f_y, f_z, f_new_y, f_new_z, f_drift, f_max_drift, f_eps;

    mov.u32 tid, %tid.x;
    setp.eq.u32 p_is_thread0, tid, 0;
    @!p_is_thread0 bra EXIT;

    mov.u32 block_idx, %ctaid.x;
    ld.param.u32 batch, [batch_size];
    setp.ge.u32 p_batch_exit, block_idx, batch;
    @p_batch_exit bra EXIT;

    ld.param.u64 q_base, [question_ptr];
    ld.param.u64 curr_y_base, [answer_ptr];
    ld.param.u64 curr_z_base, [latent_ptr];
    ld.param.u64 answer_out_base, [answer_out_ptr];
    ld.param.u64 latent_out_base, [latent_out_ptr];
    ld.param.u64 flag_ptr, [halt_flags_ptr];
    ld.param.u32 dim, [hidden_dim];
    ld.param.u32 rec_limit, [n_recursions];
    ld.param.f32 f_eps, [epsilon];

    // Advance pointers to this batch element.
    mul.wide.u32 offset, block_idx, dim;
    mul.lo.u64 offset, offset, 4;
    add.u64 q_base, q_base, offset;
    add.u64 curr_y_base, curr_y_base, offset;
    add.u64 curr_z_base, curr_z_base, offset;
    add.u64 answer_out_base, answer_out_base, offset;
    add.u64 latent_out_base, latent_out_base, offset;

    mov.u64 next_y_base, answer_out_base;
    mov.u64 next_z_base, latent_out_base;

    mov.u32 rec_count, 0;
    mov.f32 f_max_drift, 0.0;
    mov.u32 elem_idx, 0;

REC_LOOP:
    setp.ge.u32 p_rec_exit, rec_count, rec_limit;
    @p_rec_exit bra REC_FINISH;

    mov.f32 f_max_drift, 0.0;
    mov.u32 elem_idx, 0;

ELEM_LOOP:
    setp.ge.u32 p_elem_exit, elem_idx, dim;
    @p_elem_exit bra AFTER_ELEM;

    mul.wide.u32 offset, elem_idx, 4;

    add.u64 ptr_q, q_base, offset;
    ld.global.f32 f_q, [ptr_q];

    add.u64 ptr_y, curr_y_base, offset;
    ld.global.f32 f_y, [ptr_y];

    add.u64 ptr_z, curr_z_base, offset;
    ld.global.f32 f_z, [ptr_z];

    // new_z = 0.6*z + 0.2*q + 0.2*y
    mul.f32 f_new_z, f_z, 0.6;
    fma.rn.f32 f_new_z, f_q, 0.2, f_new_z;
    fma.rn.f32 f_new_z, f_y, 0.2, f_new_z;

    // new_y = 0.5*y + 0.5*new_z
    mul.f32 f_new_y, f_y, 0.5;
    fma.rn.f32 f_new_y, f_new_z, 0.5, f_new_y;

    sub.f32 f_drift, f_new_z, f_z;
    abs.f32 f_drift, f_drift;
    max.f32 f_max_drift, f_max_drift, f_drift;

    add.u64 ptr_out, next_y_base, offset;
    st.global.f32 [ptr_out], f_new_y;

    add.u64 ptr_out, next_z_base, offset;
    st.global.f32 [ptr_out], f_new_z;

    add.u32 elem_idx, elem_idx, 1;
    bra ELEM_LOOP;

AFTER_ELEM:
    setp.lt.f32 p_halt, f_max_drift, f_eps;
    @p_halt bra HALTED;

    // Prepare next iteration: swap current and next buffers.
    mov.u64 ptr_y, curr_y_base;
    mov.u64 curr_y_base, next_y_base;
    mov.u64 next_y_base, ptr_y;

    mov.u64 ptr_z, curr_z_base;
    mov.u64 curr_z_base, next_z_base;
    mov.u64 next_z_base, ptr_z;

    add.u32 rec_count, rec_count, 1;
    bra REC_LOOP;

HALTED:
    // Copy latest results to output buffers (they are already in next_*).
    mov.u64 curr_y_base, next_y_base;
    mov.u64 curr_z_base, next_z_base;
    mov.u32 rec_count, rec_limit; // force exit
    bra REC_FINISH;

REC_FINISH:
    // Ensure outputs contain latest state.
    mov.u32 elem_idx, 0;
COPY_Y:
    setp.ge.u32 p_elem_exit, elem_idx, dim;
    @p_elem_exit bra COPY_Z;
    mul.wide.u32 offset, elem_idx, 4;
    add.u64 ptr_y, curr_y_base, offset;
    ld.global.f32 f_y, [ptr_y];
    add.u64 ptr_out, answer_out_base, offset;
    st.global.f32 [ptr_out], f_y;
    add.u32 elem_idx, elem_idx, 1;
    bra COPY_Y;

COPY_Z:
    mov.u32 elem_idx, 0;
COPY_Z_LOOP:
    setp.ge.u32 p_elem_exit, elem_idx, dim;
    @p_elem_exit bra WRITE_FLAG;
    mul.wide.u32 offset, elem_idx, 4;
    add.u64 ptr_z, curr_z_base, offset;
    ld.global.f32 f_z, [ptr_z];
    add.u64 ptr_out, latent_out_base, offset;
    st.global.f32 [ptr_out], f_z;
    add.u32 elem_idx, elem_idx, 1;
    bra COPY_Z_LOOP;

WRITE_FLAG:
    mul.wide.u32 offset, block_idx, 4;
    add.u64 flag_ptr, flag_ptr, offset;
    // Halt flag set to 1 if max drift < epsilon, else 0.
    setp.lt.f32 p_halt, f_max_drift, f_eps;
    selp.u32 tid, 1, 0, p_halt;
    st.global.u32 [flag_ptr], tid;

EXIT:
    ret;
}
