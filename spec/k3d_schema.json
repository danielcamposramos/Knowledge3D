{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "K3D Metadata Schema",
  "description": "Placeholder schema describing the structure of K3D metadata.",
  "type": "object",
  "properties": {
    "id": {"type": "string"},
    "vector": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 3,
      "maxItems": 3
    },
    "metadata": {
      "type": "object",
      "properties": {
        "label": {"type": "string"},
        "type": {"type": "string"}
      },
      "required": ["label", "type"],
      "additionalProperties": false
    },
    "neighbors": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Related node identifiers",
      "uniqueItems": true
    }
  },
  "required": ["id", "vector"]
}
