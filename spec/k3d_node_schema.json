{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "K3D Node",
  "description": "Draft schema for a single knowledge node as described in the EchoSystems action plan.",
  "type": "object",
  "properties": {
    "id": {"type": "string"},
    "vector": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 3,
      "maxItems": 3
    },
    "embedding": {
      "type": "array",
      "items": {"type": "number"},
      "description": "Original high-dimensional embedding vector."
    },
    "metadata": {
      "type": "object",
      "properties": {
        "label": {"type": "string"},
        "type": {"type": "string"}
      },
      "additionalProperties": true
    },
    "neighbors": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Related node identifiers",
      "uniqueItems": true
    }
  },
  "required": ["id", "vector", "embedding"]
}
