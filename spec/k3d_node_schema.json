{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "K3D Node",
  "description": "Schema for a single knowledge node in a K3D file.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for this node."
    },
    "sourceVector": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "The original, high-dimensional source vector."
    },
    "metadata": {
      "type": "object",
      "description": "Arbitrary metadata for the node.",
      "properties": {
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": ["label"]
    },
    "neighbors": {
      "type": "array",
      "description": "Relationships to other nodes.",
      "items": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "description": "The ID of the related node."
          },
          "distance": {
            "type": "number",
            "description": "The distance or weight of the relationship."
          }
        },
        "required": ["nodeId"]
      }
    }
  },
  "required": ["id", "metadata"]
}
