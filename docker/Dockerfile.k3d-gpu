FROM nvidia/cuda:11.8.0-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    PATH=/opt/conda/bin:$PATH \
    MAMBA_ROOT_PREFIX=/opt/conda

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates git build-essential bzip2 \
    libglib2.0-0 libgl1 ffmpeg \
 && rm -rf /var/lib/apt/lists/*

# Install micromamba (conda-forge, no ToS prompt)
RUN curl -L https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xvj -C /usr/local/bin --strip-components=1 bin/micromamba \
 && micromamba shell init -s bash -r /opt/conda \
 && mkdir -p /opt/conda && chown -R root:root /opt/conda

WORKDIR /workspace

# Copy env files for reproducible installs (optional)
COPY envs/k3d-rapids.yml /tmp/k3d-rapids.yml
COPY envs/k3d-cpu.yml /tmp/k3d-cpu.yml

# Create a base env with GPU FAISS and common deps. cuML is optional and can be added later.
RUN micromamba install -y -c conda-forge -c pytorch -c nvidia \
    python=3.10 \
    faiss-gpu=1.7.2 cudatoolkit=11.8 \
    "numpy<2" scikit-learn pip \
    && micromamba clean -a -y

# Add RAPIDS cuML (GPU UMAP) — strict GPU policy requires this for UMAP reducers
RUN micromamba install -y -c rapidsai -c conda-forge -c nvidia \
    cuml=24.06 cudatoolkit=11.8 \
    && micromamba clean -a -y

# Pre-install commonly used pip deps
RUN /opt/conda/bin/pip install -U pip wheel setuptools \
    pandas pygltflib umap-learn sentence-transformers evaluate websockets \
    pillow opencv-python-headless open_clip_torch torchvision av torchaudio soundfile laion-clap \
    --extra-index-url https://download.pytorch.org/whl/cu118

# Default command drops into bash; mount repo at /workspace
CMD ["bash"]
